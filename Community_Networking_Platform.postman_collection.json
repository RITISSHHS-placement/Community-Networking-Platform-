    {
      "name": "📅 Events",
      "description": "Event creation (organiser/manager/admin), public discovery, RSVP, analytics, and bulk CSV import.",
      "item": [

        {
          "name": "Discover Events (Public)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/api/events/discover",
              "host": ["{{baseUrl}}"],
              "path": ["api", "events", "discover"]
            },
            "description": "Public endpoint — no auth required. Returns all upcoming events."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('Returns array', () => pm.expect(pm.response.json()).to.be.an('array'));",
                  "if (pm.response.json().length > 0) {",
                  "  pm.collectionVariables.set('eventId', String(pm.response.json()[0].id));",
                  "  console.log('eventId set to', pm.response.json()[0].id);",
                  "}"
