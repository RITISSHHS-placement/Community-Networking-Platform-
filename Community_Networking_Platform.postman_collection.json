{
  "info": {
    "name": "Community Networking Platform",
    "description": "Complete API collection for the Community Networking Platform Spring Boot backend.\n\n**How to use:**\n1. Set the `baseUrl` collection variable to `http://localhost:8081`\n2. Run **Register** or **Login** first — the test script auto-saves the JWT to `{{token}}`\n3. All other requests use `{{token}}` automatically via collection-level Bearer auth\n4. Use `{{userId}}`, `{{communityId}}`, `{{eventId}}`, `{{postId}}` variables for ID-based requests\n\n**Roles accepted:** GUEST, MEMBER, MODERATOR, EVENT_ORGANISER, COMMUNITY_MANAGER, ADMIN",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    { "key": "baseUrl",      "value": "http://localhost:8081", "type": "string" },
    { "key": "token",        "value": "",  "type": "string" },
    { "key": "userId",       "value": "1", "type": "string" },
    { "key": "communityId",  "value": "1", "type": "string" },
    { "key": "eventId",      "value": "1", "type": "string" },
    { "key": "postId",       "value": "1", "type": "string" }
  ],
  "item": [

    {
      "name": "🔓 Auth",
      "description": "Register, login, and logout. Login and Register auto-save the JWT to {{token}} and {{userId}} via the test script.",
      "item": [

        {
          "name": "Register",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept",       "value": "application/json" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "register"]
            },
            "description": "Creates a new user account.\n\n**Password rules:** min 8 chars, must include uppercase, lowercase, digit, and special character.\n\n**Roles:** GUEST | MEMBER | MODERATOR | EVENT_ORGANISER | COMMUNITY_MANAGER | ADMIN",
            "body": {
              "mode": "raw",
              "options": { "raw": { "language": "json" } },
              "raw": "{\n  \"name\": \"Alice Smith\",\n  \"email\": \"alice@example.com\",\n  \"phoneNumber\": \"9876543210\",\n  \"password\": \"Secure@123\",\n  \"role\": \"MEMBER\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "pm.test('Response is JSON', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json'));",
                  "pm.test('Token present', () => pm.expect(pm.response.json()).to.have.property('token'));",
                  "if (pm.response.code === 201) {",
                  "  const d = pm.response.json();",
                  "  pm.collectionVariables.set('token',  d.token);",
                  "  pm.collectionVariables.set('userId', String(d.userId));",
                  "  console.log('Token saved. userId =', d.userId);",
                  "}"
                ]
              }
            }
          ],
          "response": [
            {
              "name": "201 Created",
              "status": "Created", "code": 201,
              "_postman_previewlanguage": "json",
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"token\": \"eyJhbGciOiJIUzI1NiJ9.example.token\",\n  \"userId\": 1,\n  \"name\": \"Alice Smith\",\n  \"email\": \"alice@example.com\",\n  \"role\": \"MEMBER\"\n}"
            },
            {
              "name": "400 Validation error (weak password)",
              "status": "Bad Request", "code": 400,
              "_postman_previewlanguage": "json",
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"timestamp\": \"2026-09-02T10:15:30\",\n  \"status\": 400,\n  \"error\": \"Bad Request\",\n  \"message\": \"Password must meet security requirements\"\n}"
            },
            {
              "name": "409 Email already registered",
              "status": "Conflict", "code": 409,
              "_postman_previewlanguage": "json",
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"timestamp\": \"2026-09-02T10:15:30\",\n  \"status\": 409,\n  \"error\": \"Conflict\",\n  \"message\": \"This email is already registered\"\n}"
            }
          ]
        },

        {
          "name": "Login",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept",       "value": "application/json" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            },
            "description": "Multi-credential login. `identifier` can be email address, phone number, or numeric user ID.",
            "body": {
              "mode": "raw",
              "options": { "raw": { "language": "json" } },
              "raw": "{\n  \"identifier\": \"alice@example.com\",\n  \"password\": \"Secure@123\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('Token present', () => pm.expect(pm.response.json()).to.have.property('token'));",
                  "if (pm.response.code === 200) {",
                  "  const d = pm.response.json();",
                  "  pm.collectionVariables.set('token',  d.token);",
                  "  pm.collectionVariables.set('userId', String(d.userId));",
                  "  console.log('Logged in as', d.email, '| role:', d.role);",
                  "}"
                ]
              }
            }
          ],
          "response": [
            {
              "name": "200 OK",
              "status": "OK", "code": 200,
              "_postman_previewlanguage": "json",
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"token\": \"eyJhbGciOiJIUzI1NiJ9.example.token\",\n  \"userId\": 1,\n  \"name\": \"Alice Smith\",\n  \"email\": \"alice@example.com\",\n  \"role\": \"MEMBER\"\n}"
            },
            {
              "name": "400 Blank identifier or password",
              "status": "Bad Request", "code": 400,
              "_postman_previewlanguage": "json",
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"timestamp\": \"2026-09-02T10:15:30\",\n  \"status\": 400,\n  \"error\": \"Bad Request\",\n  \"message\": \"Email, username, or mobile is required\"\n}"
            },
            {
              "name": "401 Wrong credentials",
              "status": "Unauthorized", "code": 401,
              "_postman_previewlanguage": "json",
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"timestamp\": \"2026-09-02T10:15:30\",\n  \"status\": 401,\n  \"error\": \"Unauthorized\",\n  \"message\": \"Invalid credentials. Please check your email and password.\"\n}"
            }
          ]
        },

        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/api/auth/logout",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "logout"]
            },
            "description": "Blacklists the current JWT so it can no longer authenticate. Uses the collection-level Bearer token."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('Logout message', () => pm.expect(pm.response.json().message).to.include('Logged out'));",
                  "pm.collectionVariables.set('token', '');",
                  "console.log('Token cleared from collection variables.');"
                ]
              }
            }
          ],
          "response": [
            {
              "name": "200 OK",
              "status": "OK", "code": 200,
              "_postman_previewlanguage": "json",
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"message\": \"Logged out successfully\"\n}"
            }
          ]
        }

      ]
    },

    {
      "name": "👤 Members & Profile",
      "description": "Member registration, profile lookup, and profile updates.",
      "item": [

        {
          "name": "Register Member (alias)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept",       "value": "application/json" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/members/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "members", "register"]
            },
            "description": "Alternative registration endpoint — identical to /api/auth/register. Useful for registering users with operational roles.",
            "body": {
              "mode": "raw",
              "options": { "raw": { "language": "json" } },
              "raw": "{\n  \"name\": \"Dana Okafor\",\n  \"email\": \"dana@example.com\",\n  \"phoneNumber\": \"9123456780\",\n  \"password\": \"Secure@123\",\n  \"role\": \"COMMUNITY_MANAGER\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "if (pm.response.code === 201) {",
                  "  const d = pm.response.json();",
                  "  pm.collectionVariables.set('token',  d.token);",
                  "  pm.collectionVariables.set('userId', String(d.userId));",
                  "}"
                ]
              }
            }
          ],
          "response": []
        },

        {
          "name": "Get Member by ID",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/api/members/{{userId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "members", "{{userId}}"]
            },
            "description": "Returns public profile of a member by their numeric ID. Requires auth."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200 or 404', () => pm.expect([200, 404]).to.include(pm.response.code));",
                  "if (pm.response.code === 200) pm.test('Has id field', () => pm.expect(pm.response.json()).to.have.property('id'));"
                ]
              }
            }
          ],
          "response": [
            {
              "name": "200 OK",
              "status": "OK", "code": 200,
              "_postman_previewlanguage": "json",
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"id\": 1,\n  \"name\": \"Alice Smith\",\n  \"email\": \"alice@example.com\",\n  \"phoneNumber\": \"9876543210\",\n  \"role\": \"MEMBER\",\n  \"createdDate\": \"2026-09-02T10:15:30\"\n}"
            },
            {
              "name": "404 Not Found",
              "status": "Not Found", "code": 404,
              "_postman_previewlanguage": "json",
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"timestamp\": \"2026-09-02T10:15:30\",\n  \"status\": 404,\n  \"error\": \"Not Found\",\n  \"message\": \"Member not found with id: 999\"\n}"
            }
          ]
        },

        {
          "name": "Get My Profile",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/api/users/profile",
              "host": ["{{baseUrl}}"],
              "path": ["api", "users", "profile"]
            },
            "description": "Returns the profile of the currently authenticated user derived from the JWT."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('Has email', () => pm.expect(pm.response.json()).to.have.property('email'));"
                ]
              }
            }
          ],
          "response": [
            {
              "name": "200 OK",
              "status": "OK", "code": 200,
              "_postman_previewlanguage": "json",
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"id\": 1,\n  \"name\": \"Alice Smith\",\n  \"email\": \"alice@example.com\",\n  \"phoneNumber\": \"9876543210\",\n  \"role\": \"MEMBER\",\n  \"createdDate\": \"2026-09-02T10:15:30\"\n}"
            }
          ]
        },

        {
          "name": "Update My Profile",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept",       "value": "application/json" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/users/profile",
              "host": ["{{baseUrl}}"],
              "path": ["api", "users", "profile"]
            },
            "description": "Updates name and/or phoneNumber for the authenticated user. Email and password are intentionally not editable here. Only changed fields need to be sent — both are optional.",
            "body": {
              "mode": "raw",
              "options": { "raw": { "language": "json" } },
              "raw": "{\n  \"name\": \"Alice K. Smith\",\n  \"phoneNumber\": \"9000000001\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('Name updated', () => pm.expect(pm.response.json().name).to.be.a('string'));"
                ]
              }
            }
          ],
          "response": [
            {
              "name": "200 OK",
              "status": "OK", "code": 200,
              "_postman_previewlanguage": "json",
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"id\": 1,\n  \"name\": \"Alice K. Smith\",\n  \"email\": \"alice@example.com\",\n  \"phoneNumber\": \"9000000001\",\n  \"role\": \"MEMBER\",\n  \"createdDate\": \"2026-09-02T10:15:30\"\n}"
            }
          ]
        }

      ]
    },

    {
      "name": "🏘️ Communities",
      "description": "Create communities, browse the public discovery feed, and join communities.",
      "item": [

        {
          "name": "Discover Communities (Public)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/api/communities/discover",
              "host": ["{{baseUrl}}"],
              "path": ["api", "communities", "discover"]
            },
            "description": "Public endpoint — no auth required. Returns all active communities."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('Returns array', () => pm.expect(pm.response.json()).to.be.an('array'));",
                  "if (pm.response.json().length > 0) {",
                  "  pm.collectionVariables.set('communityId', String(pm.response.json()[0].id));",
                  "  console.log('communityId set to', pm.response.json()[0].id);",
                  "}"
                ]
              }
            }
          ],
          "response": [
            {
              "name": "200 OK",
              "status": "OK", "code": 200,
              "_postman_previewlanguage": "json",
              "header": [{ "key": "Content-Type", "value": "application/json" }],
