        {
          "name": "Create Event",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept",       "value": "application/json" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/events",
              "host": ["{{baseUrl}}"],
              "path": ["api", "events"]
            },
            "description": "Creates a new event.\n\n**Roles required:** EVENT_ORGANISER, COMMUNITY_MANAGER, or ADMIN\n\n**ticketType:** FREE or PAID\n**eventDate:** ISO-8601 future datetime",
            "body": {
              "mode": "raw",
              "options": { "raw": { "language": "json" } },
              "raw": "{\n  \"title\": \"React & Beyond Workshop\",\n  \"eventDate\": \"2027-01-18T10:00:00\",\n  \"location\": \"Coimbatore Tech Park\",\n  \"lat\": 11.0168,\n  \"lng\": 76.9558,\n  \"capacity\": 200,\n  \"ticketType\": \"PAID\",\n  \"price\": 25.00\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "if (pm.response.code === 201) {",
                  "  pm.collectionVariables.set('eventId', String(pm.response.json().id));",
                  "  console.log('eventId set to', pm.response.json().id);",
                  "}"
                ]
              }
            }
          ],
          "response": [
            {
              "name": "201 Created",
              "status": "Created", "code": 201,
              "_postman_previewlanguage": "json",
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"id\": 3,\n  \"title\": \"React & Beyond Workshop\",\n  \"eventDate\": \"2027-01-18T10:00:00\",\n  \"location\": \"Coimbatore Tech Park\",\n  \"capacity\": 200,\n  \"rsvpCount\": 0,\n  \"ticketType\": \"PAID\",\n  \"price\": 25.0,\n  \"status\": \"UPCOMING\"\n}"
            },
            {
              "name": "403 Forbidden (wrong role)",
              "status": "Forbidden", "code": 403,
              "_postman_previewlanguage": "json",
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"timestamp\": \"2026-09-02T10:15:30\",\n  \"status\": 403,\n  \"error\": \"Forbidden\",\n  \"message\": \"Access Denied\"\n}"
            }
          ]
        },

        {
          "name": "RSVP to Event",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/api/events/{{eventId}}/rsvp",
              "host": ["{{baseUrl}}"],
